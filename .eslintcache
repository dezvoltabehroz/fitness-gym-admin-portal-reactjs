area\",\n               group: \"social\",\n               toolbar: {\n                  show: false,\n               },\n               zoom: {\n                  enabled: false,\n               },\n            },\n            dataLabels: {\n               enabled: false,\n            },\n            stroke: {\n               width: [2, 2],\n               colors: [\"#F46B68\", \"#2BC155\"],\n               curve: \"straight\",\n            },\n            legend: {\n               tooltipHoverFormatter: function (val, opts) {\n                  return (\n                     val +\n                     \" - \" +\n                     opts.w.globals.series[opts.seriesIndex][\n                        opts.dataPointIndex\n                     ] +\n                     \"\"\n                  );\n               },\n               markers: {\n                  fillColors: [\"#F46B68\", \"#2BC155\"],\n                  width: 19,\n                  height: 19,\n                  strokeWidth: 0,\n                  radius: 19,\n               },\n            },\n            markers: {\n               size: 6,\n               border: 0,\n               colors: [\"#F46B68\", \"#2BC155\"],\n               hover: {\n                  size: 6,\n               },\n            },\n            xaxis: {\n               categories: [\n                  \"January\",\n                  \"February\",\n                  \"March\",\n                  \"April\",\n                  \"May\",\n                  \"June\",\n                  \"July\",\n                  \"August\",\n                  \"September\",\n                  \"October\",\n                  \"November\",\n                  \"December\",\n                  \"10 Jan\",\n                  \"11 Jan\",\n                  \"12 Jan\",\n               ],\n            },\n            yaxis: {\n               labels: {\n                  style: {\n                     colors: \"#3e4954\",\n                     fontSize: \"14px\",\n                     fontFamily: \"Poppins\",\n                     fontWeight: 100,\n                  },\n               },\n            },\n            fill: {\n               colors: [\"#F46B68\", \"#2BC155\"],\n               type: \"solid\",\n               opacity: 0.07,\n            },\n            grid: {\n               borderColor: \"#f1f1f1\",\n            },\n         },\n      };\n   }\n\n   render() {\n      return (\n         <div id=\"chart\">\n            <ReactApexChart\n               options={this.state.options}\n               series={this.state.series}\n               type=\"area\"\n               height={350}\n            />\n         </div>\n      );\n   }\n}\n\nexport default ApexLine;\n","D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\Chartjs\\bar5.js",[],"D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\Chartjs\\bar6.js",[],"D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\apexcharts\\Line3.js",["972"],"import React, { Component } from \"react\";\nimport ReactApexChart from \"react-apexcharts\";\n\nclass ApexLine3 extends React.Component {\n   constructor(props) {\n      super(props);\n\n      this.state = {\n         series: [\n            {\n               name: \"Running\",\n               data: [20, 40, 20, 80, 40, 40, 20, 60, 60, 20, 110, 60],\n            },\n         ],\n         options: {\n            chart: {\n               height: 350,\n               type: \"area\",\n               toolbar: {\n                  show: false,\n               },\n            },\n            dataLabels: {\n               enabled: false,\n            },\n\n            stroke: {\n               width: [4],\n               colors: [\"#00b4e5\"],\n               curve: \"straight\",\n            },\n\n            xaxis: {\n               type: \"text\",\n               categories: [\n                  \"Jan\",\n                  \"Feb\",\n                  \"Mar\",\n                  \"Apr\",\n                  \"May\",\n                  \"Jun\",\n                  \"Jul\",\n                  \"Aug\",\n                  \"Sep\",\n                  \"Oct\",\n                  \"Nov\",\n                  \"Dec\",\n               ],\n            },\n            colors: [\"#00b4e5\"],\n            markers: {\n               size: [6],\n               strokeWidth: [4],\n               strokeColors: [\"#00b4e5\"],\n               border: 0,\n               colors: [\"#fff\"],\n               hover: {\n                  size: 10,\n               },\n            },\n            yaxis: {\n               title: {\n                  text: \"\",\n               },\n            },\n         },\n      };\n   }\n\n   render() {\n      return (\n         <div id=\"chart\">\n            <ReactApexChart\n               options={this.state.options}\n               series={this.state.series}\n               type=\"area\"\n               height={350}\n            />\n         </div>\n      );\n   }\n}\n\nexport default ApexLine3;\n","D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\apexcharts\\RadialBar.js",["973"],"import React, { Component } from \"react\";\nimport ReactApexChart from \"react-apexcharts\";\n\nclass ApexRedialBar extends React.Component {\n   constructor(props) {\n      super(props);\n\n      this.state = {\n         series: [81],\n         options: {\n            chart: {\n               height: 300,\n               type: \"radialBar\",\n               offsetY: -10,\n            },\n            plotOptions: {\n               radialBar: {\n                  startAngle: -135,\n                  endAngle: 135,\n                  dataLabels: {\n                     name: {\n                        fontSize: \"16px\",\n                        color: undefined,\n                        offsetY: 120,\n                     },\n                     value: {\n                        offsetY: 0,\n                        fontSize: \"34px\",\n                        color: \"black\",\n                        formatter: function (val) {\n                           return val + \"%\";\n                        },\n                     },\n                  },\n               },\n            },\n            fill: {\n               type: \"gradient\",\n               colors: \"00b4e5\",\n               gradient: {\n                  shade: \"dark\",\n                  shadeIntensity: 0.15,\n                  inverseColors: false,\n                  opacityFrom: 1,\n                  opacityTo: 1,\n                  stops: [0, 50, 65, 91],\n               },\n            },\n            stroke: {\n               dashArray: 4,\n               colors: \"00b4e5\",\n            },\n            labels: [\"\"],\n         },\n      };\n   }\n\n   render() {\n      return (\n         <div id=\"chart\">\n            <ReactApexChart\n               options={this.state.options}\n               series={this.state.series}\n               type=\"radialBar\"\n               height={350}\n            />\n         </div>\n      );\n   }\n}\nexport default ApexRedialBar;\n","D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\apexcharts\\Bar3.js",[],"D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\apexcharts\\Bar2.js",[],"D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\chartist\\polar.jsx",["974"],"import React, { Component } from 'react';\nimport ChartistGraph from 'react-chartist';\n\n\n\nfunction PolarChart() {\n    var data = {\n        labels: [1, 2, 3, 4, 5, 6, 7, 8],\n        series: [\n            [1, 2, 3, 1, -2, 0, 1, 0],\n            [-2, -1, -2, -1, -2.5, -1, -2, -1],\n            [0, 0, 0, 1, 2, 2.5, 2, 1],\n            [2.5, 2, 1, 0.5, 1, 0.5, -1, -2.5]\n        ]\n    };\n\n    var options = {\n        high: 3,\n        low: -3,\n        showArea: true,\n        showLine: false,\n        showPoint: false,\n        fullWidth: true,\n\t\theight: 250,\n        axisX: {\n            showLabel: false,\n            showGrid: false\n        },\n    };\n\n    var type = 'Line'\n\n    return (\n        <>\n            <ChartistGraph data={data} options={options} type={type} />\n        </>\n    )\n}\n\nexport default PolarChart;","D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\AppsMenu\\Shop\\ProductList\\SingleProductList.js",[],"D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\chartist\\donut.jsx",[],"D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\chartist\\area.jsx",["975"],"import React, { Component } from 'react';\nimport ChartistGraph from 'react-chartist';\n\n\n\nfunction AreaChart() {\n    var data = {\n        labels: ['Mon', 'Tues', 'Wednes', 'Thurs', 'Fri'],\n        series: [\n            [12, 9, 7, 8, 5],\n        ]\n    };\n\n    var options = {\n        fullWidth: true,\n        showArea: true,\n\t\theight: 250,\n        chartPadding: {\n            right: 20\n        }\n    };\n\n    var type = 'Line'\n\n    return (\n        <>\n            <ChartistGraph data={data} options={options} type={type} />\n        </>\n    )\n}\n\nexport default AreaChart;","D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\chartist\\line.jsx",["976"],"import React, { Component } from 'react';\nimport ChartistGraph from 'react-chartist';\n\n\n\nfunction LineChart() {\n    var data = {\n        labels: ['Mon', 'Tues', 'Wednes', 'Thurs', 'Fri'],\n        series: [\n            [12, 9, 7, 8, 5],\n            [2, 1, 3.5, 7, 3],\n            [1, 3, 4, 5, 6]\n        ]\n    };\n\n    var options = {\n        fullWidth: true,\n\t\theight:250,\n        chartPadding: {\n            right: 20\n        }\n    };\n\n    var type = 'Line'\n\n    return (\n        <>\n            <ChartistGraph data={data} options={options} type={type} />\n        </>\n    )\n}\n\nexport default LineChart;","D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\charts\\chartist\\bar.jsx",["977","978"],"import React, { Component } from \"react\";\nimport ChartistGraph from \"react-chartist\";\n\nfunction BarChart() {\n   var data = {\n      labels: [\n         \"Jan\",\n         \"Feb\",\n         \"Mar\",\n         \"Apr\",\n         \"May\",\n         \"Jun\",\n         \"Jul\",\n         \"Aug\",\n         \"Sep\",\n         \"Oct\",\n         \"Nov\",\n         \"Dec\",\n      ],\n      series: [\n         [5, 4, 3, 7, 5, 10, 3, 4, 8, 10, 6, 8],\n         [3, 2, 9, 5, 4, 6, 4, 6, 7, 8, 7, 4],\n         [4, 6, 3, 9, 6, 5, 2, 8, 3, , 5, 4],\n      ],\n   };\n\n   var options = {\n      fullWidth: true,\n      seriesBarDistance: 10,\n\t  height: 250,\n      chartPadding: {\n         right: 5,\n      },\n   };\n\n   var type = \"Bar\";\n\n   return (\n      <>\n         <ChartistGraph data={data} options={options} type={type} id=\"abc\" />\n      </>\n   );\n}\n\nexport default BarChart;\n","D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\AppsMenu\\Calendar\\EventCalendar.js",["979"],"import React, { Component } from \"react\";\nimport ReactDOM from \"react-dom\";\nimport { Col, Row } from \"react-bootstrap\";\nimport FullCalendar from \"@fullcalendar/react\";\nimport dayGridPlugin from \"@fullcalendar/daygrid\";\nimport timeGridPlugin from \"@fullcalendar/timegrid\";\nimport interactionPlugin, { Draggable } from \"@fullcalendar/interaction\";\nimport Alert from \"sweetalert2\";\n\nclass EventCalendar extends Component {\n   state = {\n      calendarEvents: [\n         {\n            title: \"Atlanta Monster\",\n            start: new Date(\"2019-04-04 00:00\"),\n            id: \"99999998\",\n         },\n         {\n            title: \"My Favorite Murder\",\n            start: new Date(\"2019-04-05 00:00\"),\n            id: \"99999999\",\n         },\n      ],\n      events: [\n         { title: \"Event 1\", id: \"1\" },\n         { title: \"Event 2\", id: \"2\" },\n         { title: \"Event 3\", id: \"3\" },\n         { title: \"Event 4\", id: \"4\" },\n         { title: \"Event 5\", id: \"5\" },\n      ],\n   };\n\n   /**\n    * adding dragable properties to external events through javascript\n    */\n   componentDidMount() {\n      let draggableEl = document.getElementById(\"external-events\");\n      new Draggable(draggableEl, {\n         itemSelector: \".fc-event\",\n         eventData: function (eventEl) {\n            let title = eventEl.getAttribute(\"title\");\n            let id = eventEl.getAttribute(\"data\");\n            return {\n               title: title,\n               id: id,\n            };\n         },\n      });\n   }\n\n   /**\n    * when we click on event we are displaying event details\n    */\n   eventClick = (eventClick) => {\n      Alert.fire({\n         title: eventClick.event.title,\n         html:\n            `<div className=\"table-responsive\">\n      <table className=\"table\">\n      <tbody>\n      <tr >\n      <td>Title</td>\n      <td><strong>` +\n            eventClick.event.title +\n            `</strong></td>\n      </tr>\n      <tr >\n      <td>Start Time</td>\n      <td><strong>\n      ` +\n            eventClick.event.start +\n            `\n      </strong></td>\n      </tr>\n      </tbody>\n      </table>\n      </div>`,\n\n         showCancelButton: true,\n         confirmButtonColor: \"#d33\",\n         cancelButtonColor: \"#3085d6\",\n         confirmButtonText: \"Remove Event\",\n         cancelButtonText: \"Close\",\n      }).then((result) => {\n         if (result.value) {\n            eventClick.event.remove(); // It will remove event from the calendar\n            Alert.fire(\"Deleted!\", \"Your Event has been deleted.\", \"success\");\n         }\n      });\n   };\n\n   render() {\n      return (\n         <div className=\"animated fadeIn demo-app\">\n            <Row>\n               <Col lg={3}>\n\t\t\t\t\t<div className=\"card\">\n\t\t\t\t\t\t<div className=\"card-header border-0 pb-0\">\n\t\t\t\t\t\t\t<h4 className=\"text-black fs-20 mb-0\">Events</h4>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div className=\"card-body\" id=\"external-events\">\n\t\t\t\t\t\t\t{this.state.events.map((event) => (\n\t\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t   className=\"fc-event mt-0 ml-0 mb-2 btn btn-block btn-primary\"\n\t\t\t\t\t\t\t\t   title={event.title}\n\t\t\t\t\t\t\t\t   data={event.id}\n\t\t\t\t\t\t\t\t   key={event.id}\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t   {event.title}\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t))}\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n               </Col>\n\n               <Col lg={9}>\n\t\t\t\t\t<div className=\"card\">\n\t\t\t\t\t\t<div className=\"card-body\">\n\t\t\t\t\t\t\t<div className=\"demo-app-calendar\" id=\"mycalendartest\">\n\t\t\t\t\t\t\t\t<FullCalendar\n\t\t\t\t\t\t\t\t\tdefaultView=\"dayGridMonth\"\n\t\t\t\t\t\t\t\t\theader={{\n\t\t\t\t\t\t\t\t\t   left: \"prev,next today\",\n\t\t\t\t\t\t\t\t\t   center: \"title\",\n\t\t\t\t\t\t\t\t\t   right:\n\t\t\t\t\t\t\t\t\t\t  \"dayGridMonth,timeGridWeek,timeGridDay,listWeek\",\n\t\t\t\t\t\t\t\t\t}}\n\t\t\t\t\t\t\t\t\trerenderDelay={10}\n\t\t\t\t\t\t\t\t\teventDurationEditable={false}\n\t\t\t\t\t\t\t\t\teditable={true}\n\t\t\t\t\t\t\t\t\tdroppable={true}\n\t\t\t\t\t\t\t\t\tplugins={[\n\t\t\t\t\t\t\t\t\t   dayGridPlugin,\n\t\t\t\t\t\t\t\t\t   timeGridPlugin,\n\t\t\t\t\t\t\t\t\t   interactionPlugin,\n\t\t\t\t\t\t\t\t\t]}\n\t\t\t\t\t\t\t\t\tref={this.calendarComponentRef}\n\t\t\t\t\t\t\t\t\tweekends={this.state.calendarWeekends}\n\t\t\t\t\t\t\t\t\tevents={this.state.calendarEvents}\n\t\t\t\t\t\t\t\t\teventDrop={this.drop}\n\t\t\t\t\t\t\t\t\t// drop={this.drop}\n\t\t\t\t\t\t\t\t\teventReceive={this.eventReceive}\n\t\t\t\t\t\t\t\t\teventClick={this.eventClick}\n\t\t\t\t\t\t\t\t\t// selectable={true}\n\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n               </Col>\n            </Row>\n         </div>\n      );\n   }\n}\n\nexport default EventCalendar;\n","D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\table\\tableData.js",[],"D:\\Infinity Bits\\Educo Gym\\Admin-Portal\\src\\jsx\\components\\chatBox\\Chat.js",["980","981"],"import React, { useState } from \"react\";\n\n/// Images\nimport avatar1 from \"../../../images/avatar/1.jpg\";\nimport avatar2 from \"../../../images/avatar/2.jpg\";\nimport avatar3 from \"../../../images/avatar/3.jpg\";\nimport avatar4 from \"../../../images/avatar/4.jpg\";\nimport avatar5 from \"../../../images/avatar/5.jpg\";\nimport MsgBox from \"./MsgBox\";\n\nconst Chat = ({ PerfectScrollbar, toggleChatBox, toggleTab }) => {\n   const [openMsg, setOpenMsg] = useState(false);\n   return (\n      <div\n         className={`tab-pane fade  ${\n            toggleTab === \"chat\" ? \"active show\" : \"\"\n         }`}\n         id=\"chat\"\n         role=\"tabpanel\"\n      >\n         <div\n            className={`card mb-sm-3 mb-md-0 contacts_card dz-chat-user-box ${\n               openMsg ? \"d-none\" : \"\"\n            }`}\n         >\n            <div className=\"card-header chat-list-header text-center\">\n               <a href=\"#\">\n                  <svg\n                     xmlns=\"http://www.w3.org/2000/svg\"\n                     xmlnsXlink=\"http://www.w3.org/1999/xlink\"\n                     width=\"18px\"\n                     height=\"18px\"\n                     viewBox=\"0 0 24 24\"\n                     version=\"1.1\"\n                  >\n                     <g\n                        stroke=\"none\"\n                        strokeWidth=\"1\"\n                        fill=\"none\"\n                        fillRule=\"evenodd\"\n                     >\n                        <rect\n                           fill=\"#000000\"\n                           x=\"4\"\n                           y=\"11\"\n                           width=\"16\"\n                           height=\"2\"\n                           rx=\"1\"\n                        />\n                        <rect\n                           fill=\"#000000\"\n                           opacity=\"0.3\"\n                           transform=\"translate(12.000000, 12.000000) rotate(-270.000000) translate(-12.000000, -12.000000) \"\n                           x=\"4\"\n                           y=\"11\"\n                           width=\"16\"\n                           height=\"2\"\n                           rx=\"1\"\n                        />\n                     </g>\n                  </svg>\n               </a>\n               <div>\n                  <h6 className=\"mb-1\">Chat List</h6>\n                  <p className=\"mb-0\">Show All</p>\n               </div>\n               <a href=\"#\">\n                  <svg\n                     xmlns=\"http://www.w3.org/2000/svg\"\n                     xmlnsXlink=\"http://www.w3.org/1999/xlink\"\n                     width=\"18px\"\n                     height=\"18px\"\n                     viewBox=\"0 0 24 24\"\n                     version=\"1.1\"\n                  >\n                     <g\n                        stroke=\"none\"\n                        strokeWidth=\"1\"\n                        fill=\"none\"\n                        fillRule=\"evenodd\"\n                     >\n                        <rect x=\"0\" y=\"0\" width=\"24\" height=\"24\" />\n                        <circle fill=\"#000000\" cx=\"5\" cy=\"12\" r=\"2\" />\n                        <circle fill=\"#000000\" cx=\"12\" cy=\"12\" r=\"2\" />\n                        <circle fill=\"#000000\" cx=\"19\" cy=\"12\" r=\"2\" />\n                     </g>\n                  </svg>\n               </a>\n            </div>\n            <PerfectScrollbar\n               className={`card-body contacts_body p-0 dz-scroll  ${\n                  toggleChatBox ? \"ps ps--active-y\" : \"\"\n               }`}\n               id=\"DZ_W_Contacts_Body\"\n            >\n               <ul className=\"contacts\">\n                  <li className=\"name-first-letter\">A</li>\n                  <li\n                     className=\"active dz-chat-user\"\n                     onClick={() => setOpenMsg(true)}\n                  >\n                     <div className=\"d-flex bd-highlight\">\n                        <div className=\"img_cont\">\n                           <img\n                              src={avatar1}\n                              className=\"rounded-circle user_img\"\n                              alt=\"\"\n                           />\n                           <span className=\"online_icon\"></span>\n                        </div>\n                        <div className=\"user_info\">\n                           <span>Archie Parker</span>\n                           <p>Kalid is online</p>\n                        </div>\n                     </div>\n                  </li>\n                  <li className=\"dz-chat-user\" onClick={() => setOpenMsg(true)}>\n                     <div className=\"d-flex bd-highlight\">\n                        <div className=\"img_cont\">\n                           <img\n                              src={avatar2}\n                              className=\"rounded-circle user_img\"\n                              alt=\"\"\n                           />\n                           <span className=\"online_icon offline\"></span>\n                        </div>\n                        <div className=\"user_info\">\n                           <span>Alfie Mason</span>\n                           <p>Taherah left 7 mins ago</p>\n                        </div>\n                     </div>\n                  </li>\n                  <li className=\"dz-chat-user\" onClick={() => setOpenMsg(true)}>\n                     <div className=\"d-flex bd-highlight\">\n                        <div className=\"img_cont\">\n                           <img\n                              src={avatar3}\n                              className=\"rounded-circle user_img\"\n                              alt=\"\"\n                           />\n                           <span className=\"online_icon\"></span>\n                        </div>\n                        <div className=\"user_info\">\n                           <span>AharlieKane</span>\n                           <p>Sami is online</p>\n                        </div>\n                     </div>\n                  </li>\n                  <li className=\"dz-chat-user\" onClick={() => setOpenMsg(true)}>\n                     <div className=\"d-flex bd-highlight\">\n                        <div className=\"img_cont\">\n                           <img\n                              src={avatar4}\n                              className=\"rounded-circle user_img\"\n                              alt=\"\"\n                           />\n                           <span className=\"online_icon offline\"></span>\n                        </div>\n                        <div className=\"user_info\">\n                           <span>Athan Jacoby</span>\n                           <p>Nargis left 30 mins ago</p>\n                        </div>\n                     </div>\n                  </li>\n                  <li className=\"name-first-letter\">B</li>\n                  <li className=\"dz-chat-user\" onClick={() => setOpenMsg(true)}>\n                     <div className=\"d-flex bd-highlight\">\n                        <div className=\"img_cont\">\n                           <img\n                              src={avatar5}\n                              className=\"rounded-circle user_img\"\n                              alt=\"\"\n                           />\n                           <span className=\"online_icon offline\"></span>\n                        </div>\n                        <div className=\"user_info\">\n                           <span>Bashid Samim</span>\n                           <p>Rashid left 50 mins ago</p>\n                        </div>\n           